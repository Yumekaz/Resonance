	    queue_item_id text,
	    selection_token uuid,
	    client_instance_id uuid NOT NULL,
	    started_at timestamptz NOT NULL DEFAULT now(),
	    meaningful_at timestamptz,
	    completed_at timestamptz,
	    ended_at timestamptz,
